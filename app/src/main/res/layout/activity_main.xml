<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="WattFlow"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/btnTheme"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_dark_mode"
                android:contentDescription="Toggle theme"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- MAX CHARGING SPEED -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MAX CHARGING SPEED"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type your charging speed"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/etWattage"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:gravity="center"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="W"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- BATTERY CAPACITY (NEW) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BATTERY CAPACITY"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Auto-detected on first launch"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <EditText
                    android:id="@+id/etCapacity"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Auto-detect"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:background="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="mAh"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gray number = your phone's real capacity (auto-detected). If it looks wrong, type the correct value. Clear the box to restore the gray number."
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textAlignment="center"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- YOUR PHONE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR PHONE"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search your charging speed →"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="13sp"
                android:textColor="@color/accent_blue"
                android:padding="10dp"
                android:background="@drawable/bg_input"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Search on Google"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- UPDATE INTERVAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UPDATE INTERVAL"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <SeekBar
                android:id="@+id/seekInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="4"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvIntervalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:padding="10dp"
                android:background="@drawable/bg_input"
                android:text="3s (Mid battery usage)" />
        </LinearLayout>

        <!-- DISCHARGE AVERAGE WINDOW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DISCHARGE AVERAGE WINDOW"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Real-time first, then rolling average"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp" />

            <SeekBar
                android:id="@+id/seekDischargeAvg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="9"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvDischargeAvgLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:padding="10dp"
                android:background="@drawable/bg_input"
                android:text="1 min — less accurate (fast response)"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Short window = less accurate, reacts fast\nLong window = more accurate, smoother\n\nBest for gaming &amp; long sessions: 5–10 min"
                android:textSize="11sp"
                android:textColor="@color/text_muted"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Monitoring"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_primary"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Stop Monitoring"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_button_danger"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ℹ️  How the time is calculated"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ This time may differ from your phone's built-in estimate, and from other battery apps like DevCheck or AccuBattery. Those use their own internal algorithms. This app uses pure watt-based math from the live battery sensor, so numbers will not match exactly."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔋  Discharge average window"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When discharging, the app shows real-time estimate first. After the window time you chose, it switches to a rolling average.\n\n•  Short window (1–2 min)  →  less accurate, reacts fast.\n•  Long window (8–10 min)  →  more accurate, best for gaming.\n•  Middle (3–5 min)  →  balanced."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔬  Battery capacity detection"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On first launch, the app reads your phone's real battery capacity from the fuel gauge and saves it. This lets the %/min calculation adapt to different battery sizes — a small 4000 mAh battery charges faster per minute than a large 6000 mAh one at the same wattage."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Developed by SilentStrangerX"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>